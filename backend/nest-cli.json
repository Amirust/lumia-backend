{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "projects": {
    "better-auth": {
      "type": "library",
      "root": "libs/better-auth",
      "entryFile": "index",
      "sourceRoot": "libs/better-auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/better-auth/tsconfig.lib.json"
      }
    },
    "db": {
      "type": "library",
      "root": "libs/db",
      "entryFile": "index",
      "sourceRoot": "libs/db/src",
      "compilerOptions": {
        "tsConfigPath": "libs/db/tsconfig.lib.json"
      }
    },
    "events": {
      "type": "library",
      "root": "libs/events",
      "entryFile": "index",
      "sourceRoot": "libs/events/src",
      "compilerOptions": {
        "tsConfigPath": "libs/events/tsconfig.lib.json"
      }
    },
    "lru-cache": {
      "type": "library",
      "root": "libs/lru-cache",
      "entryFile": "index",
      "sourceRoot": "libs/lru-cache/src",
      "compilerOptions": {
        "tsConfigPath": "libs/lru-cache/tsconfig.lib.json"
      }
    },
    "ml-client": {
      "type": "library",
      "root": "libs/ml-client",
      "entryFile": "index",
      "sourceRoot": "libs/ml-client/src",
      "compilerOptions": {
        "tsConfigPath": "libs/ml-client/tsconfig.lib.json"
      }
    },
    "r2": {
      "type": "library",
      "root": "libs/r2",
      "entryFile": "index",
      "sourceRoot": "libs/r2/src",
      "compilerOptions": {
        "tsConfigPath": "libs/r2/tsconfig.lib.json"
      }
    },
    "response": {
      "type": "library",
      "root": "libs/response",
      "entryFile": "index",
      "sourceRoot": "libs/response/src",
      "compilerOptions": {
        "tsConfigPath": "libs/response/tsconfig.lib.json"
      }
    },
    "task-queue": {
      "type": "library",
      "root": "libs/task-queue",
      "entryFile": "index",
      "sourceRoot": "libs/task-queue/src",
      "compilerOptions": {
        "tsConfigPath": "libs/task-queue/tsconfig.lib.json"
      }
    },
    "types": {
      "type": "library",
      "root": "libs/types",
      "entryFile": "index",
      "sourceRoot": "libs/types/src",
      "compilerOptions": {
        "tsConfigPath": "libs/types/tsconfig.lib.json"
      }
    },
    "utils": {
      "type": "library",
      "root": "libs/utils",
      "entryFile": "index",
      "sourceRoot": "libs/utils/src",
      "compilerOptions": {
        "tsConfigPath": "libs/utils/tsconfig.lib.json"
      }
    }
  }
}