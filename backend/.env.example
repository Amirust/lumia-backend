APP_PORT=7000

# Database (used by TypeORM via DATABASE url)
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# In provided docker-compose files, DB name is omitted and defaults to the server default (often "postgres").
DATABASE=postgres://postgres:postgres@localhost:5432

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Cloudflare R2 File Storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# PostgreSQL credentials used by docker-compose (db service)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DATABASE=

# Backend Config
TASK_QUEUE_WORKER_CONCURRENCY=8
OPENAPI_ENABLED=true

FRONTEND_ORIGIN=http://localhost:3000
